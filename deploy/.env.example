# /opt/app/.env en el servidor. Una copia por entorno (staging / production). Nunca se versiona
# con valores reales. Sin comentarios en línea: los scripts leen los valores con cut.

# Dominio público (el registro DNS A debe apuntar a la IP elástica que da Terraform)
DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com
# Nombre del entorno que muestra la app (staging / production)
APP_ENV=staging

# Imágenes: ghcr.io/<IMAGE_NAMESPACE>/taskflow-{backend,frontend}:<IMAGE_TAG>
# IMAGE_NAMESPACE es tu usuario u organización de GitHub, en minúsculas.
REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-user
# Lo gestiona scripts/deploy.sh: no tocar a mano.
IMAGE_TAG=

POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
DB_POOL_MAX=10
LOG_LEVEL=info

# Perfiles de Compose activos (vacío para desactivar la observabilidad)
COMPOSE_PROFILES=monitoring

# Backups (bucket creado por Terraform; vacío = solo copia local)
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=
AWS_REGION=eu-west-1
