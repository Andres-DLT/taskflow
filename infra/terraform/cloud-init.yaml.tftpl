#cloud-config
# Bootstrap del servidor: Docker oficial, usuario de despliegue, SSH endurecido, firewall,
# fail2ban, parches automáticos, swap y cron de backups. Se ejecuta una sola vez al crear la instancia.

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - fail2ban
  - jq
  - rsync
  - ufw
  - unattended-upgrades

groups:
  - docker

users:
  - default
  # Usuario que usa GitHub Actions. Pertenecer a "docker" equivale a root: su clave solo vive
  # como secreto del GitHub Environment y es distinta por entorno.
  - name: deploy
    groups: [docker]
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${deploy_ssh_public_key}

swap:
  filename: /swapfile
  size: 2147483648

write_files:
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      X11Forwarding no
      AllowAgentForwarding no
      MaxAuthTries 3
      LoginGraceTime 30
      AllowUsers ubuntu deploy

  - path: /etc/docker/daemon.json
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "5" },
        "live-restore": true,
        "no-new-privileges": true,
        "userland-proxy": false
      }

  - path: /etc/fail2ban/jail.d/sshd.local
    content: |
      [sshd]
      enabled = true
      maxretry = 5
      findtime = 10m
      bantime = 1h

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  - path: /etc/sysctl.d/99-taskflow.conf
    content: |
      vm.swappiness = 10
      net.core.somaxconn = 1024

  - path: /etc/cron.d/taskflow-backup
    content: |
      15 3 * * * deploy bash /opt/app/scripts/backup.sh scheduled >> /var/log/taskflow/backup.log 2>&1

  - path: /etc/logrotate.d/taskflow
    content: |
      /var/log/taskflow/*.log {
        weekly
        rotate 8
        compress
        missingok
        notifempty
      }

  - path: /usr/local/sbin/bootstrap-taskflow.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euxo pipefail

      # Docker Engine + Compose desde el repositorio oficial (no el paquete de Ubuntu).
      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      chmod a+r /etc/apt/keyrings/docker.asc
      codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $codename stable" \
        > /etc/apt/sources.list.d/docker.list
      apt-get update
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      systemctl enable --now docker

      # Directorios de la aplicación.
      install -d -o deploy -g deploy -m 0750 /opt/app
      install -d -o deploy -g deploy -m 0700 /var/backups/taskflow
      install -d -o deploy -g deploy -m 0750 /var/log/taskflow

      # Firewall: Docker publica solo 80/443 (Grafana escucha en 127.0.0.1).
      ufw default deny incoming
      ufw default allow outgoing
      ufw allow OpenSSH
      ufw allow 80/tcp
      ufw allow 443/tcp
      ufw allow 443/udp
      ufw --force enable

      sysctl --system
      systemctl restart ssh
      systemctl enable --now fail2ban unattended-upgrades

runcmd:
  - /usr/local/sbin/bootstrap-taskflow.sh

final_message: "TaskFlow bootstrap completado en $UPTIME s"
