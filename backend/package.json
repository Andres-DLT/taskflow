{
  "name": "taskflow-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de TaskFlow (Express + PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "lint": "eslint .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**"
  },
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
